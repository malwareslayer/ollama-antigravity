[Unit]
Description=Ollama-compatible HTTP bridge backed by Antigravity ACP
Documentation=https://github.com/malwareslayer/ollama-antigravity
Wants=network-online.target
After=network.target network-online.target

[Service]
Type=simple
User=ollama-antigravity
Group=ollama-antigravity
Environment=HOME=/var/lib/ollama-antigravity
EnvironmentFile=-/etc/ollama-antigravity/env
ExecStart=/usr/bin/ollama-antigravity
WorkingDirectory=/var/lib/ollama-antigravity
StateDirectory=ollama-antigravity
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
