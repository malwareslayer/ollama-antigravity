LISTEN_ADDR=0.0.0.0:11435
AGY_BIN=agy
ACP_WORKERS=1
ACP_TIMEOUT_SEC=120
ACP_EMPTY_CWD=/tmp/hindsight-acp-empty
ACP_EXCLUDE_MODELS=gemini-pro-orchestrator-g1-pro,orchestrator
ACP_DEFAULT_MODEL=claude-sonnet-5-5-medium
ACP_DISABLE_TELEMETRY=true
