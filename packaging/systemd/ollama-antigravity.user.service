[Unit]
Description=Ollama-compatible HTTP bridge backed by Antigravity ACP (user)
Documentation=https://github.com/malwareslayer/ollama-antigravity
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-%E/ollama-antigravity/env
EnvironmentFile=-/etc/ollama-antigravity/env
ExecStart=/usr/bin/ollama-antigravity
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
